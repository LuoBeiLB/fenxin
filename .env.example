# ===== 服务 =====
PORT=9091

# ===== MySQL =====
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=root
DB_DATABASE=burnmsg
# 首次部署建表可设为 true；正式运行务必改为 false（防止自动改表丢数据）
DB_SYNC=true

# ===== JWT（生产环境务必更换为足够长的随机串，两个密钥必须不同）=====
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
# access token 有效期（秒，默认 2 小时）
ACCESS_TOKEN_TTL=7200
# refresh token 有效期（秒，默认 30 天）
REFRESH_TOKEN_TTL=2592000

# ===== CORS 白名单（逗号分隔，管理后台来源；留空则禁止一切跨域浏览器调用）=====
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ===== 文件上传 =====
UPLOAD_DIR=./uploads

# ===== 初始管理员（仅系统内无任何 admin 的首次启动时创建）=====
INITIAL_ADMIN_PHONE=13800000000
# 留空则自动生成随机密码并打印到启动日志
INITIAL_ADMIN_PASSWORD=

# ===== Swagger 文档（生产环境设为 false）=====
SWAGGER_ENABLED=true
