# ===== 服务 =====
PORT=9091

# ===== MySQL =====
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=root
DB_DATABASE=burnmsg
# 首次部署建表可设为 true；正式运行务必改为 false（防止自动改表丢数据）
DB_SYNC=true

# ===== JWT（生产环境务必更换为足够长的随机串，两个密钥必须不同）=====
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
# access token 有效期（秒，默认 2 小时）
ACCESS_TOKEN_TTL=7200
# refresh token 有效期（秒，默认 30 天）
REFRESH_TOKEN_TTL=2592000

# ===== CORS 白名单（逗号分隔，管理后台来源；* 放行所有来源（仅调试用）；留空则禁止一切跨域浏览器调用）=====
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ===== 文件上传 =====
UPLOAD_DIR=./uploads

# ===== 点开才焚 / 焚毁（V6.0 两阶段销毁） =====
# 兜底时长（小时）：焚毁消息的 destroy_at = 发送时刻 + max(本值, burn_ttl_seconds 秒)。
# 语义是"防止无人阅读导致永不销毁"，因此必须 >= 用户选择的持续时间，
# 否则会出现"7 天档消息 24 小时就被删"（V6.0 已修正）。
BURN_FALLBACK_TTL_HOURS=24

# 真删除兜底（天）：消息被标记焚毁（is_destroyed=1）后，等待前端进入会话确认；
# 超过该天数仍未确认则强制真删除（行 + 回执 + 附件），避免无限堆积。
# 0 = 关闭兜底（永不自动真删，只依赖客户端确认，慎用）
ACK_FALLBACK_DAYS=7

# 群聊真删除确认阈值：
#   1 = 任一成员确认即可真删（推荐，快且不阻塞）
#   0 = 必须所有非发送方成员（n-1）都确认才真删
PURGE_ACK_THRESHOLD=1

# 音视频"播完才焚"的消费窗口（秒）
# 窗口 = max(burn_ttl_seconds, 媒体时长 + BURN_MEDIA_BUFFER_SECONDS)
BURN_MEDIA_BUFFER_SECONDS=30
# 媒体时长缺失时的默认窗口（秒）
BURN_MEDIA_DEFAULT_WINDOW_SECONDS=300

# ===== 鉴权缓存 =====
# JwtAuthGuard 的 user+device 缓存 TTL（毫秒）；0 = 关闭缓存（调试用，每请求 2 次 SQL）
AUTH_CACHE_TTL_MS=30000

# ===== Swagger 接口文档 =====
# true 时开放 http://localhost:9091/api-docs（完整中文文档，来自 openapi.yaml）；生产环境务必设为 false
SWAGGER_ENABLED=true

# ===== 初始管理员（仅系统内无任何 admin 的首次启动时创建）=====
INITIAL_ADMIN_PHONE=13800000000
# 留空则自动生成随机密码并打印到启动日志
INITIAL_ADMIN_PASSWORD=

# ===== 阿里云 OSS 外置存储（可选；不启用则附件存本地 UPLOAD_DIR）=====
# OSS_ENABLED=true 时：上传先落本地 → 推 OSS → 删除本地副本，返回外网签名 URL
OSS_ENABLED=false
OSS_BUCKET=
OSS_REGION=oss-cn-hangzhou
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# true = 上传走内网 endpoint（服务器同地域，免流量费）；本地开发机连不通内网需设 false
OSS_INTERNAL=true
# 签名 URL 有效期（秒），默认 10 年，与旧版"URL 即永久凭证"语义对齐
OSS_URL_EXPIRES=315360000

# ===== 日志 =====
# LOG_LEVEL：日志级别 debug/info/warn/error；不设置时开发默认 debug、生产默认 info
# LOG_PRETTY：控制台彩色单行日志，true 开 / false 关。
# 不设置时：开发环境（NODE_ENV 非 production）默认开，生产默认输出 JSON 行（采集友好）。
# 注意：写成 LOG_PRETTY=（等号后留空）等同于 false 会关掉彩色，开发想开彩色请写 LOG_PRETTY=true
# LOG_LEVEL=debug
# LOG_PRETTY=true
